# Part of LangChain RAG Example by Viprasol Tech Private Limited (https://viprasol.com).
# Copy to .env and fill in only if you opt into the OpenAI backend.
# The core example runs fully offline and needs NONE of these.

# Optional: enables get_openai_embeddings(...) (requires the [openai] extra).
OPENAI_API_KEY=

# Optional: override the default embeddings model.
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
